  14:../timer2.c   **** /* Máxima precisión: preescalado 0 y divisor 1/2 -> F = 64 MHz / (1 * 2) = 32 MHz, 32 ticks por u
  15:../timer2.c   **** #define TICKS_POR_US	32
  16:../timer2.c   **** #define CUENTA_MAX		65535	// TCNTB2: la cuenta va de 65535 a 0, periodo de 65536 ticks = 2048 us
  17:../timer2.c   **** 
  18:../timer2.c   **** /* Bits del timer2 en TCON (bits 12-15) */
  19:../timer2.c   **** #define T2_START		(1 << 12)
  20:../timer2.c   **** #define T2_MANUAL_UPD	(1 << 13)
  21:../timer2.c   **** #define T2_INVERTER		(1 << 14)
  22:../timer2.c   **** #define T2_AUTO_RELOAD	(1 << 15)
  23:../timer2.c   **** #define T2_BITS			(T2_START | T2_MANUAL_UPD | T2_INVERTER | T2_AUTO_RELOAD)
  24:../timer2.c   **** 
