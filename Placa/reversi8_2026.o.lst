  23:../reversi8_2026.c **** const char FICHA_BLANCA  = 1;
  24:../reversi8_2026.c **** const char FICHA_NEGRA   = 2;
  25:../reversi8_2026.c **** 
  26:../reversi8_2026.c **** // candidatas: indica las posiciones a explorar
