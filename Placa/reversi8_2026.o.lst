  69:../reversi8_2026.c ****      // Pregunta: ¿hay que hacer algo con ellas para que esto funcione bien?
  70:../reversi8_2026.c ****      // (por ejemplo añadir alguna palabra clave para garantizar que la sincronización a través 
  71:../reversi8_2026.c **** 	    volatile char fila=0,
  72:../reversi8_2026.c **** 	    columna=0,
  73:../reversi8_2026.c **** 	    ready = 0;
