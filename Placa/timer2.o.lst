  14:../timer2.c   **** /* Máxima precisión: preescalado 0 y divisor 1/2 -> F = 64 MHz / (1 * 2) = 32 MHz, 32 ticks por u
  15:../timer2.c   **** #define TICKS_POR_US	32
  16:../timer2.c   **** #define CUENTA_MAX		65535	// TCNTB2: la cuenta va de 65535 a 0, periodo de 65536 ticks = 2048 us
