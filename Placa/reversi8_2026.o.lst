  43:../reversi8_2026.c ****     {3,4,5,0,0,5,4,3},
  44:../reversi8_2026.c ****     {3,4,5,0,0,5,4,3},
  45:../reversi8_2026.c ****     {7,4,6,5,5,6,4,7},
  46:../reversi8_2026.c ****     {2,1,4,4,4,4,1,2},
