   2              	* Fichero:		reversi8_arm.asm
   3              	* Autor:		Sergio Benedi 873042, Pablo Gimeno 960280
   4              	* Descrip:		versiones en ensamblador ARM de color_ficha() y patron_volteo()
   5              	*				(misma estructura que el C de reversi8_2026.c, cumpliendo ATPCS)
   6              	* Version:	1.0
   7              	*********************************************************************************************/
   8              	
   9              	.text
  10              	.arm
  11              	
  12              	/*******************************************************************************************
  13              	* Constantes (mismos valores que en reversi8_2026.c)
  14              	*******************************************************************************************/
  15              	.equ DIM,				8
  16              	.equ CASILLA_VACIA,		0
  17              	.equ NO_HAY_MODELO,		0
  18              	.equ MODELO_ENCONTRADO,	1
  19              	
  20              	/*******************************************************************************************
  21              	* NOTA: en arm-none-eabi-gcc "char" es SIN signo. Un indice negativo (p.ej. FA = 0 + (-1))
  22              	* queda como 0xFF, por eso basta una comparacion sin signo (< DIM) para cubrir
  23              	* tambien la condicion ">= 0", y tras cada suma hay que truncar a 8 bits (and #0xFF).
  24              	*******************************************************************************************/
  25              	
  26              	/*******************************************************************************************
  27              	* Codigo C original:
  28              	*
  29              	* char color_ficha(char tablero[][DIM], char f, char c, int *es_posicion_correcta)
  30              	* {
  31              	*     char ficha;
  32              	*
  33              	*     if ((f < DIM) && (f >= 0) && (c < DIM) && (c >= 0) && (tablero[f][c] != CASILLA_VACIA))
  34              	*     {
  35              	*         *es_posicion_correcta = 1;
  36              	*         ficha = tablero[f][c];
  37              	*     }
  38              	*     else
  39              	*     {
  40              	*         *es_posicion_correcta = 0;
  41              	*         ficha = CASILLA_VACIA;
  42              	*     }
  43              	*     return ficha;
  44              	* }
  45              	*
  46              	* Entrada:	r0 = tablero
  47              	* 			r1 = f
  48              	* 			r2 = c
  49              	* 			r3 = es_posicion_correcta (puntero)
  50              	* Salida:	r0 = ficha
  51              	* Variables locales: ficha -> r0 (no necesita pila)
  52              	*
  53              	* Marco de pila (como el del compilador):
  54              	* 	[fp]		pc
  55              	* 	[fp, #-4]	lr
  56              	* 	[fp, #-8]	sp (ip)
  57              	* 	[fp, #-12]	fp anterior
  58              	*******************************************************************************************/
  59              	#############################################################################################
  60              	# Codigo C original:
  61              	#
  62              	# char color_ficha(char tablero[][DIM], char f, char c, int *es_posicion_correcta)
  63              	# {
  64              	#     char ficha;
  65              	#
  66              	#     {
  67              	#         *es_posicion_correcta = 1;
  68              	#         ficha = tablero[f][c];
  69              	#     }
  70              	#    # else
  71              	#     {
  72              	#         *es_posicion_correcta = 0;
  73              	#         ficha = CASILLA_VACIA;
  74              	#     }
  75              	#     return ficha;
  76              	# }
  77              	#
  78              	# Entrada:	r0 = tablero
  79              	#			r1 = f
  80              	#			r2 = c
  81              	#			r3 = es_posicion_correcta (puntero)
  82              	# Salida:	r0 = ficha
  83              	# Variables locales: ficha -> r0 (no necesita pila)
  84              	#
  85              	# Marco de pila (como el del compilador):
  86              	#	[fp]		pc
  87              	#	[fp, #-4]	lr
  88              	#	[fp, #-8]	sp (ip)
  89              	#	[fp, #-12]	fp anterior
  90              	#############################################################################################
  91              	.global color_ficha_arm
  92              	color_ficha_arm:
  93 0000 0DC0A0E1 			mov		ip, sp
  94 0004 00D82DE9 			stmdb	sp!, {fp, ip, lr, pc}
  95 0008 04B04CE2 			sub		fp, ip, #4
  96              	
  97 000c 080051E3 			cmp		r1, #DIM				/* sin signo: cubre f < DIM y f >= 0 */
  98 0010 0800002A 			bhs		cf_else
  99 0014 080052E3 			cmp		r2, #DIM				/* sin signo: cubre c < DIM y c >= 0 */
 100 0018 0600002A 			bhs		cf_else
 101 001c 810180E0 			add		r0, r0, r1, lsl #3		/* r0 = &tablero[f][0] (fila de DIM = 8 = 2^3 bytes) */
 102 0020 0200D0E7 			ldrb	r0, [r0, r2]			/* ficha = tablero[f][c] */
 103 0024 000050E3 			cmp		r0, #CASILLA_VACIA
 104 0028 0200000A 			beq		cf_else
 105              	
 106 002c 0110A0E3 			mov		r1, #1
 107 0030 001083E5 			str		r1, [r3]
 108 0034 00A81BE9 			ldmdb	fp, {fp, sp, pc}
 109              	
 110              	cf_else:
 111 0038 0010A0E3 			mov		r1, #0
 112 003c 001083E5 			str		r1, [r3]
 113 0040 0000A0E3 			mov		r0, #CASILLA_VACIA
 114 0044 00A81BE9 			ldmdb	fp, {fp, sp, pc}
 115              	
 116              	/*******************************************************************************************
 117              	* Codigo C original:
 118              	*
 119              	* int patron_volteo(char tablero[][DIM], int *longitud, char FA, char CA, char SF, char SC, char co
 120              	* {
 121              	*     int es_posicion_correcta;
 122              	*     char casilla;
 123              	*
 124              	*     FA = FA + SF;
 125              	*     CA = CA + SC;
 126              	*     casilla = color_ficha(tablero, FA, CA, &es_posicion_correcta);
 127              	*     while ((es_posicion_correcta == 1) && (casilla != color))
 128              	*     {
 129              	*         FA = FA + SF;
 130              	*         CA = CA + SC;
 131              	*         *longitud = *longitud + 1;
 132              	*         casilla = color_ficha(tablero, FA, CA, &es_posicion_correcta);
 133              	*     }
 134              	*     if ((es_posicion_correcta == 1) && (casilla == color))
 135              	*         return MODELO_ENCONTRADO;
 136              	*     else
 137              	*         return NO_HAY_MODELO;
 138              	* }
 139              	*
 140              	* Entrada:	r0 = tablero
 141              	* 			r1 = longitud (puntero)
 142              	* 			r2 = FA
 143              	* 			r3 = CA
 144              	* 			[fp, #4]	SF		(5º parametro, en pila del llamador)
 145              	* 			[fp, #8]	SC		(6º parametro)
 146              	* 			[fp, #12]	color	(7º parametro)
 147              	* Salida:	r0 = MODELO_ENCONTRADO / NO_HAY_MODELO
 148              	*
 149              	* Uso de registros (r4-r10 porque sobreviven a la llamada a color_ficha):
 150              	* 	r4 = tablero	r5 = longitud	r6 = FA		r7 = CA
 151              	* 	r8 = SF			r9 = SC			r10 = color	r0 = casilla (valor devuelto)
 152              	*
 153              	* Marco de pila:
 154              	* 	[fp]			pc
 155              	* 	[fp, #-4]		lr
 156              	* 	[fp, #-8]		sp (ip)
 157              	* 	[fp, #-12]		fp anterior
 158              	* 	[fp, #-16]		r10
 159              	* 	...
 160              	* 	[fp, #-40]		r4
 161              	* 	[fp, #-44] = [sp]	es_posicion_correcta: va en pila porque se pasa su direccion a color_ficha
 162              	*******************************************************************************************/
 163              	#############################################################################################
 164              	# Codigo C original:
 165              	#
 166              	# int patron_volteo(char tablero[][DIM], int *longitud, char FA, char CA, char SF, char SC, char co
 167              	# {
 168              	#     int es_posicion_correcta;
 169              	#     char casilla;
 170              	#
 171              	#     FA = FA + SF;
 172              	#     CA = CA + SC;
 173              	#     casilla = color_ficha(tablero, FA, CA, &es_posicion_correcta);
 174              	#     while ((es_posicion_correcta == 1) && (casilla != color))
 175              	#     {
 176              	#         FA = FA + SF;
 177              	#         CA = CA + SC;
 178              	#         *longitud = *longitud + 1;
 179              	#         casilla = color_ficha(tablero, FA, CA, &es_posicion_correcta);
 180              	#     }
 181              	#         return MODELO_ENCONTRADO;
 182              	#   #  else
 183              	#         return NO_HAY_MODELO;
 184              	# }
 185              	#
 186              	# Entrada:	r0 = tablero
 187              	#			r1 = longitud (puntero)
 188              	#			r2 = FA
 189              	#			r3 = CA
 190              	#			[fp, #4]	SF		(5º parametro, en pila del llamador)
 191              	#			[fp, #8]	SC		(6º parametro)
 192              	#			[fp, #12]	color	(7º parametro)
 193              	# Salida:	r0 = MODELO_ENCONTRADO / NO_HAY_MODELO
 194              	#
 195              	# Uso de registros (r4-r10 porque sobreviven a la llamada a color_ficha):
 196              	#	r4 = tablero	r5 = longitud	r6 = FA		r7 = CA
 197              	#	r8 = SF			r9 = SC			r10 = color	r0 = casilla (valor devuelto)
 198              	#
 199              	# Marco de pila:
 200              	#	[fp]			pc
 201              	#	[fp, #-4]		lr
 202              	#	[fp, #-8]		sp (ip)
 203              	#	[fp, #-12]		fp anterior
 204              	#	[fp, #-16]		r10
 205              	#	...
 206              	#	[fp, #-40]		r4
 207              	#	[fp, #-44] = [sp]	es_posicion_correcta: va en pila porque se pasa su direccion a color_ficha
 208              	#############################################################################################
 209              	.global patron_volteo_arm
 210              	.extern color_ficha
 211              	patron_volteo_arm:
 212 0048 0DC0A0E1 			mov		ip, sp
 213 004c F0DF2DE9 			stmdb	sp!, {r4-r10, fp, ip, lr, pc}
 214 0050 04B04CE2 			sub		fp, ip, #4
 215 0054 04D04DE2 			sub		sp, sp, #4				/* int es_posicion_correcta -> [sp] */
 216              	
 217 0058 0040A0E1 			mov		r4, r0					/* r4 = tablero */
 218 005c 0150A0E1 			mov		r5, r1					/* r5 = longitud */
 219 0060 0480DBE5 			ldrb	r8, [fp, #4]			/* r8 = SF */
 220 0064 0890DBE5 			ldrb	r9, [fp, #8]			/* r9 = SC */
 221 0068 0CA0DBE5 			ldrb	r10, [fp, #12]			/* r10 = color */
 222              	
 223 006c 086082E0 			add		r6, r2, r8
 224 0070 FF6006E2 			and		r6, r6, #0xFF			/* FA es char: truncar a 8 bits */
 225 0074 097083E0 			add		r7, r3, r9
 226 0078 FF7007E2 			and		r7, r7, #0xFF
 227 007c 0400A0E1 			mov		r0, r4
 228 0080 0610A0E1 			mov		r1, r6
 229 0084 0720A0E1 			mov		r2, r7
 230 0088 0D30A0E1 			mov		r3, sp
 231 008c FEFFFFEB 			bl		color_ficha				/* cambiar por color_ficha_arm para probar la version ARM */
 232              	
 233              	pv_while:
 234 0090 00109DE5 			ldr		r1, [sp]
 235 0094 010051E3 			cmp		r1, #1
 236 0098 0E00001A 			bne		pv_fin_while
 237 009c 0A0050E1 			cmp		r0, r10
 238 00a0 0C00000A 			beq		pv_fin_while
 239              	
 240 00a4 086086E0 			add		r6, r6, r8
 241 00a8 FF6006E2 			and		r6, r6, #0xFF
 242 00ac 097087E0 			add		r7, r7, r9
 243 00b0 FF7007E2 			and		r7, r7, #0xFF
 244 00b4 001095E5 			ldr		r1, [r5]
 245 00b8 011081E2 			add		r1, r1, #1
 246 00bc 001085E5 			str		r1, [r5]
 247 00c0 0400A0E1 			mov		r0, r4
 248 00c4 0610A0E1 			mov		r1, r6
 249 00c8 0720A0E1 			mov		r2, r7
 250 00cc 0D30A0E1 			mov		r3, sp
 251 00d0 FEFFFFEB 			bl		color_ficha
 252 00d4 EDFFFFEA 			b		pv_while
 253              	
 254              	pv_fin_while:
 255 00d8 00109DE5 			ldr		r1, [sp]
 256 00dc 010051E3 			cmp		r1, #1
 257 00e0 0A005001 			cmpeq	r0, r10
 258 00e4 0100A003 			moveq	r0, #MODELO_ENCONTRADO
 259 00e8 0000A013 			movne	r0, #NO_HAY_MODELO
 260 00ec F0AF1BE9 			ldmdb	fp, {r4-r10, fp, sp, pc}
 261              	
 262              	.end
