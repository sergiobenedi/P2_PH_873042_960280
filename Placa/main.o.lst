  14:../main.c     **** /* 1: calibrar timer2 contra Delay() antes de jugar (Paso 7); 0: solo el juego */
  15:../main.c     **** #define CALIBRAR_TIMER2 0
  16:../main.c     **** 
  17:../main.c     **** /*--- variables globales ---*/
  18:../main.c     **** /* us medidos por timer2 para Delay() de 1 ms, 10 ms, 1 s y 10 s (ver en Expressions) */
  19:../main.c     **** unsigned int tiempos_calibracion[4];
  20:../main.c     **** 
  21:../main.c     **** /*--- codigo de funciones ---*/
  22:../main.c     **** #if CALIBRAR_TIMER2
  23:../main.c     **** static void calibrar_timer2(void)
  24:../main.c     **** {
  25:../main.c     **** 	/* Delay(n) espera n * 100 us */
  26:../main.c     **** 	static const int esperas[4] = { 10, 100, 10000, 100000 };
  27:../main.c     **** 	int i;
  28:../main.c     **** 
  29:../main.c     **** 	for (i = 0; i < 4; i++)
  30:../main.c     **** 	{
  31:../main.c     **** 		timer2_empezar();
  32:../main.c     **** 		Delay(esperas[i]);
  33:../main.c     **** 		tiempos_calibracion[i] = timer2_parar();
  34:../main.c     **** 	}
  35:../main.c     **** }
  36:../main.c     **** #endif
