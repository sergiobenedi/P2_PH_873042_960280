  51:../reversi8_2026.c **** // Tabla de direcciones. Contiene los desplazamientos de las 8 direcciones posibles
  52:../reversi8_2026.c **** const char vSF[DIM] = {-1,-1, 0, 1, 1, 1, 0,-1};
  53:../reversi8_2026.c **** const char vSC[DIM] = { 0, 1, 1, 1, 0,-1,-1,-1};
  54:../reversi8_2026.c **** 
