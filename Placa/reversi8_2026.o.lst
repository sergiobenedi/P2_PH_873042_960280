 153:../reversi8_2026.c **** // POR RUTINAS EN ENSAMBLADOR HAY QUE RESPETAR LA MODULARIDAD.
 154:../reversi8_2026.c **** // DEBEN SEGUIR SIENDO LLAMADAS A FUNCIONES Y DEBEN CUMPLIR CON EL ATPCS
 155:../reversi8_2026.c **** // (VER TRANSPARENCIAS Y MATERIAL DE PRACTICAS):
 156:../reversi8_2026.c **** //  - DEBEN PASAR LOS PARAMETROS POR LOS REGISTROS CORRESPONDIENTES
 157:../reversi8_2026.c **** //  - GUARDAR EN PILA SOLO LOS REGISTROS QUE TOCAN
 158:../reversi8_2026.c **** //  - CREAR UN MARCO DE PILA TAL Y COMO MUESTRAN LAS TRANSPARENCIAS
 159:../reversi8_2026.c **** //    DE LA ASIGNATURA (CON EL PC, FP, LR,....)
 160:../reversi8_2026.c **** //  - EN EL CASO DE LAS VARIABLES LOCALES, SOLO HAY QUE APILARLAS
 161:../reversi8_2026.c **** //    SI NO SE PUEDEN COLOCAR EN UN REGISTRO.
 162:../reversi8_2026.c **** //    SI SE COLOCAN EN UN REGISTRO NO HACE FALTA
 163:../reversi8_2026.c **** //    NI GUARDARLAS EN PILA NI RESERVAR UN ESPACIO EN LA PILA PARA ELLAS
