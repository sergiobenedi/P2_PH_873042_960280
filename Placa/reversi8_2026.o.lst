  84:../reversi8_2026.c **** 
  85:../reversi8_2026.c **** // Version de patron_volteo que usa el juego: patron_volteo (C) o patron_volteo_arm (ARM)
  86:../reversi8_2026.c **** #define PATRON_VOLTEO patron_volteo
  87:../reversi8_2026.c **** 
  88:../reversi8_2026.c **** // Version de color_ficha que llama patron_volteo (C): color_ficha (C), color_ficha_arm (ARM) o col
  89:../reversi8_2026.c **** #define COLOR_FICHA color_ficha
