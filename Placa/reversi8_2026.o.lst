  16:../reversi8_2026.c **** 	NO_HAY_MODELO = 0,
  17:../reversi8_2026.c ****   	MODELO_ENCONTRADO = 1
  18:../reversi8_2026.c **** };
  19:../reversi8_2026.c **** 
  20:../reversi8_2026.c **** // Estados de las casillas del tablero
  21:../reversi8_2026.c **** // debería ser enum, lo dejamos como const para usar char...
