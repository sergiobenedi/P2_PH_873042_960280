  28:../reversi8_2026.c **** // Sus posibles valores son NO, SI, CASILLA_OCUPADA
  29:../reversi8_2026.c **** const char  NO              = 0;
  30:../reversi8_2026.c **** const char  SI              = 1;
  31:../reversi8_2026.c **** const char  CASILLA_OCUPADA = 2;
