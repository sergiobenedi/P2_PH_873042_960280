  91:../reversi8_2026.c **** ///////////////////////////////////////////////////////////////////////////////////////////////////
  92:../reversi8_2026.c **** // 0 indica CASILLA_VACIA, 1 indica FICHA_BLANCA y 2 indica FICHA_NEGRA
  93:../reversi8_2026.c **** // pone el tablero a cero y luego coloca las fichas centrales.
  94:../reversi8_2026.c **** 
  95:../reversi8_2026.c **** static void init_table(char tablero[][DIM], char candidatas[][DIM])
  96:../reversi8_2026.c **** {
  97:../reversi8_2026.c ****     int i, j;
  98:../reversi8_2026.c **** 
  99:../reversi8_2026.c ****     for (i = 0; i < DIM; i++)
 100:../reversi8_2026.c ****     {
 101:../reversi8_2026.c ****         for (j = 0; j < DIM; j++)
 102:../reversi8_2026.c ****             tablero[i][j] = CASILLA_VACIA;
 103:../reversi8_2026.c ****     }
 104:../reversi8_2026.c **** #if 0
 105:../reversi8_2026.c ****     for (i = 3; i < 5; ++i) {
 106:../reversi8_2026.c **** 	for(j = 3; j < 5; ++j) {
 107:../reversi8_2026.c **** 	    tablero[i][j] = i == j ? FICHA_BLANCA : FICHA_NEGRA;
 108:../reversi8_2026.c **** 	}
 109:../reversi8_2026.c ****     }
 110:../reversi8_2026.c **** 
 111:../reversi8_2026.c ****     for (i = 2; i < 6; ++i) {
 112:../reversi8_2026.c **** 	for (j = 2; j < 6; ++j) {
 113:../reversi8_2026.c **** 	    if((i>=3) && (i < 5) && (j>=3) && (j<5)) {
 114:../reversi8_2026.c **** 		candidatas[i][j] = CASILLA_OCUPADA;
 115:../reversi8_2026.c **** 	    } else {
 116:../reversi8_2026.c **** 		candidatas[i][j] = SI; //CASILLA_LIBRE;
 117:../reversi8_2026.c **** 	    }
 118:../reversi8_2026.c **** 	}
 119:../reversi8_2026.c ****     }
 120:../reversi8_2026.c **** #endif
 121:../reversi8_2026.c ****     // arriba hay versión alternativa
 122:../reversi8_2026.c ****     tablero[3][3] = FICHA_BLANCA;
 123:../reversi8_2026.c ****     tablero[4][4] = FICHA_BLANCA;
 124:../reversi8_2026.c ****     tablero[3][4] = FICHA_NEGRA;
 125:../reversi8_2026.c ****     tablero[4][3] = FICHA_NEGRA;
 126:../reversi8_2026.c **** 
 127:../reversi8_2026.c ****     candidatas[3][3] = CASILLA_OCUPADA;
 128:../reversi8_2026.c ****     candidatas[4][4] = CASILLA_OCUPADA;
 129:../reversi8_2026.c ****     candidatas[3][4] = CASILLA_OCUPADA;
 130:../reversi8_2026.c ****     candidatas[4][3] = CASILLA_OCUPADA;
 131:../reversi8_2026.c **** 
 132:../reversi8_2026.c ****     // casillas a explorar:
 133:../reversi8_2026.c ****     candidatas[2][2] = SI;
 134:../reversi8_2026.c ****     candidatas[2][3] = SI;
 135:../reversi8_2026.c ****     candidatas[2][4] = SI;
 136:../reversi8_2026.c ****     candidatas[2][5] = SI;
 137:../reversi8_2026.c ****     candidatas[3][2] = SI;
 138:../reversi8_2026.c ****     candidatas[3][5] = SI;
 139:../reversi8_2026.c ****     candidatas[4][2] = SI;
 140:../reversi8_2026.c ****     candidatas[4][5] = SI;
 141:../reversi8_2026.c ****     candidatas[5][2] = SI;
 142:../reversi8_2026.c ****     candidatas[5][3] = SI;
 143:../reversi8_2026.c ****     candidatas[5][4] = SI;
 144:../reversi8_2026.c ****     candidatas[5][5] = SI;
 145:../reversi8_2026.c **** }
 146:../reversi8_2026.c **** 
 147:../reversi8_2026.c **** ////////////////////////////////////////////////////////////////////////////////
 148:../reversi8_2026.c **** // Espera a que ready valga 1.
 149:../reversi8_2026.c **** // CUIDADO: si el compilador coloca esta variable en un registro, no funcionará.
 150:../reversi8_2026.c **** // Hay que definirla como "volatile" para forzar a que antes de cada uso la cargue de memoria
 151:../reversi8_2026.c **** 
 152:../reversi8_2026.c **** static void esperar_mov(volatile char *ready)
 153:../reversi8_2026.c **** {
 154:../reversi8_2026.c ****     while (*ready == 0) {};  // bucle de espera de respuestas hasta que el se modifique el valor de
 155:../reversi8_2026.c **** 
 156:../reversi8_2026.c ****     *ready = 0;  //una vez que pasemos el bucle volvemos a fijar ready a 0;
 157:../reversi8_2026.c **** }
 158:../reversi8_2026.c **** 
 159:../reversi8_2026.c **** ////////////////////////////////////////////////////////////////////////////////
 160:../reversi8_2026.c **** //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 161:../reversi8_2026.c **** // IMPORTANTE: AL SUSTITUIR color_ficha() Y patron_volteo()
 162:../reversi8_2026.c **** // POR RUTINAS EN ENSAMBLADOR HAY QUE RESPETAR LA MODULARIDAD.
 163:../reversi8_2026.c **** // DEBEN SEGUIR SIENDO LLAMADAS A FUNCIONES Y DEBEN CUMPLIR CON EL ATPCS
 164:../reversi8_2026.c **** // (VER TRANSPARENCIAS Y MATERIAL DE PRACTICAS):
 165:../reversi8_2026.c **** //  - DEBEN PASAR LOS PARAMETROS POR LOS REGISTROS CORRESPONDIENTES
 166:../reversi8_2026.c **** //  - GUARDAR EN PILA SOLO LOS REGISTROS QUE TOCAN
 167:../reversi8_2026.c **** //  - CREAR UN MARCO DE PILA TAL Y COMO MUESTRAN LAS TRANSPARENCIAS
 168:../reversi8_2026.c **** //    DE LA ASIGNATURA (CON EL PC, FP, LR,....)
 169:../reversi8_2026.c **** //  - EN EL CASO DE LAS VARIABLES LOCALES, SOLO HAY QUE APILARLAS
 170:../reversi8_2026.c **** //    SI NO SE PUEDEN COLOCAR EN UN REGISTRO.
 171:../reversi8_2026.c **** //    SI SE COLOCAN EN UN REGISTRO NO HACE FALTA
 172:../reversi8_2026.c **** //    NI GUARDARLAS EN PILA NI RESERVAR UN ESPACIO EN LA PILA PARA ELLAS
 173:../reversi8_2026.c **** //++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 174:../reversi8_2026.c **** ////////////////////////////////////////////////////////////////////////////////
 175:../reversi8_2026.c **** // Devuelve el contenido de la posición indicadas por la fila y columna actual.
 176:../reversi8_2026.c **** // Además informa si la posición es válida y contiene alguna ficha.
 177:../reversi8_2026.c **** // Esto lo hace por referencia (en *es_posicion_correcta)
 178:../reversi8_2026.c **** // Si devuelve un 0 no es válida o está vacía.
 179:../reversi8_2026.c **** 
 180:../reversi8_2026.c **** // sin static: patron_volteo_arm (reversi8_arm.asm) la llama
 181:../reversi8_2026.c **** char color_ficha(char tablero[][DIM], char f, char c, int *es_posicion_correcta)
 182:../reversi8_2026.c **** {
 183:../reversi8_2026.c ****     char ficha;
 184:../reversi8_2026.c **** 
 185:../reversi8_2026.c ****     // ficha = tablero[f][c];
 186:../reversi8_2026.c ****     // no puede accederse a tablero[f][c]
 187:../reversi8_2026.c ****     // ya que algún índice puede ser negativo
 188:../reversi8_2026.c **** 
 189:../reversi8_2026.c ****     if ((f < DIM) && (f >= 0) && (c < DIM) && (c >= 0) && (tablero[f][c] != CASILLA_VACIA))
 190:../reversi8_2026.c ****     {
 191:../reversi8_2026.c ****         *es_posicion_correcta = 1;
 192:../reversi8_2026.c ****         ficha = tablero[f][c];
 193:../reversi8_2026.c ****     }
 194:../reversi8_2026.c ****     else
 195:../reversi8_2026.c ****     {
 196:../reversi8_2026.c ****         *es_posicion_correcta = 0;
 197:../reversi8_2026.c ****         ficha = CASILLA_VACIA;
 198:../reversi8_2026.c ****     }
 199:../reversi8_2026.c ****     return ficha;
 200:../reversi8_2026.c **** }
 201:../reversi8_2026.c **** 
 202:../reversi8_2026.c **** ////////////////////////////////////////////////////////////////////////////////
 203:../reversi8_2026.c **** // La función patron_volteo comprueba si hay que actualizar una determinada dirección,
 204:../reversi8_2026.c **** // busca el patrón de volteo (n fichas del rival seguidas de una ficha del jugador actual)
 205:../reversi8_2026.c **** // en una dirección determinada
 206:../reversi8_2026.c **** // SF y SC son las cantidades a sumar para movernos en la dirección que toque
 207:../reversi8_2026.c **** // color indica el color de la pieza que se acaba de colocar
 208:../reversi8_2026.c **** // la función devuelve MODELO_ENCONTRADO (1) si encuentra patrón y NO_HAY_MODELO (0) en caso cont
 209:../reversi8_2026.c **** // FA y CA son la fila y columna a analizar
 210:../reversi8_2026.c **** // longitud es un parámetro por referencia. Sirve para saber la longitud del patrón que se está 
 211:../reversi8_2026.c **** //          Se usa para saber cuantas fichas habría que voltear
 212:../reversi8_2026.c **** 
 213:../reversi8_2026.c **** static int patron_volteo(char tablero[][DIM], int *longitud, char FA, char CA, char SF, char SC, ch
 214:../reversi8_2026.c **** {
 215:../reversi8_2026.c **** 	int es_posicion_correcta; // indica si la posición es correcta y contiene una ficha de algún jug
 216:../reversi8_2026.c **** 	char casilla;   // casilla es la casilla que se lee del tablero
 217:../reversi8_2026.c **** 
 218:../reversi8_2026.c **** 	FA = FA + SF;
 219:../reversi8_2026.c **** 	CA = CA + SC;
 220:../reversi8_2026.c **** 	casilla = COLOR_FICHA(tablero, FA, CA, &es_posicion_correcta);
 221:../reversi8_2026.c **** 	while ((es_posicion_correcta == 1) && (casilla != color))
 222:../reversi8_2026.c **** 	// mientras la casilla está en el tablero, no está vacía,
 223:../reversi8_2026.c **** 	// y es del color rival seguimos buscando el modelo de volteo
 224:../reversi8_2026.c **** 	{
 225:../reversi8_2026.c **** 		FA = FA + SF;
 226:../reversi8_2026.c **** 		CA = CA + SC;
 227:../reversi8_2026.c **** 		*longitud = *longitud + 1;
 228:../reversi8_2026.c **** 		casilla = COLOR_FICHA(tablero, FA, CA, &es_posicion_correcta);
 229:../reversi8_2026.c **** 	}
 230:../reversi8_2026.c ****     // si la ultima posición era válida y la ficha es del jugador actual,
 231:../reversi8_2026.c ****     // entonces hemos encontrado el patrón
 232:../reversi8_2026.c **** 	if ((es_posicion_correcta == 1) && (casilla == color))
 233:../reversi8_2026.c **** 		return MODELO_ENCONTRADO; // si hay que voltear una ficha o más hemos encontrado el patrón
 234:../reversi8_2026.c **** 	else
 235:../reversi8_2026.c **** 		return NO_HAY_MODELO; // si no hay que voltear no hay patrón
 236:../reversi8_2026.c **** }
 237:../reversi8_2026.c **** 
 238:../reversi8_2026.c **** ////////////////////////////////////////////////////////////////////////////////
 239:../reversi8_2026.c **** // voltea n fichas en la dirección que toque
 240:../reversi8_2026.c **** // SF y SC son las cantidades a sumar para movernos en la dirección que toque
 241:../reversi8_2026.c **** // color indica el color de la pieza que se acaba de colocar
 242:../reversi8_2026.c **** // FA y CA son la fila y columna a analizar
 243:../reversi8_2026.c **** 
 244:../reversi8_2026.c **** static void voltear(char tablero[][DIM], char FA, char CA, char SF, char SC, int n, char color)
 245:../reversi8_2026.c **** {
 246:../reversi8_2026.c ****     int i;
 247:../reversi8_2026.c **** 
 248:../reversi8_2026.c ****     for (i = 0; i < n; i++)
 249:../reversi8_2026.c ****     {
 250:../reversi8_2026.c ****         FA = FA + SF;
 251:../reversi8_2026.c ****         CA = CA + SC;
 252:../reversi8_2026.c ****         tablero[FA][CA] = color;
 253:../reversi8_2026.c ****     }
 254:../reversi8_2026.c **** }
 255:../reversi8_2026.c **** 
 256:../reversi8_2026.c **** ////////////////////////////////////////////////////////////////////////////////
 257:../reversi8_2026.c **** // comprueba si hay que actualizar alguna ficha
 258:../reversi8_2026.c **** // no comprueba que el movimiento realizado sea válido
 259:../reversi8_2026.c **** // f y c son la fila y columna a analizar
 260:../reversi8_2026.c **** // char vSF[DIM] = {-1,-1, 0, 1, 1, 1, 0,-1};
 261:../reversi8_2026.c **** // char vSC[DIM] = { 0, 1, 1, 1, 0,-1,-1,-1};
 262:../reversi8_2026.c **** 
 263:../reversi8_2026.c **** static int actualizar_tablero(char tablero[][DIM], char f, char c, char color)
 264:../reversi8_2026.c **** {
 265:../reversi8_2026.c ****     char SF, SC; // cantidades a sumar para movernos en la dirección que toque
 266:../reversi8_2026.c ****     int i, flip, modelo;
 267:../reversi8_2026.c **** 
 268:../reversi8_2026.c ****     for (i = 0; i < DIM; i++) // 0 es Norte, 1 NE, 2 E ...
 269:../reversi8_2026.c ****     {
 270:../reversi8_2026.c ****         SF = vSF[i];
 271:../reversi8_2026.c ****         SC = vSC[i];
 272:../reversi8_2026.c ****         // flip: numero de fichas a voltear
 273:../reversi8_2026.c ****         flip = 0;
 274:../reversi8_2026.c ****         modelo = PATRON_VOLTEO(tablero, &flip, f, c, SF, SC, color);
 275:../reversi8_2026.c ****         //printf("Flip: %d \n", flip);
 276:../reversi8_2026.c ****         if (modelo == MODELO_ENCONTRADO )
 277:../reversi8_2026.c ****         {
 278:../reversi8_2026.c ****             voltear(tablero, f, c, SF, SC, flip, color);
 279:../reversi8_2026.c ****         }
 280:../reversi8_2026.c ****     }
 281:../reversi8_2026.c ****     return 0;
 282:../reversi8_2026.c **** }
 283:../reversi8_2026.c **** 
 284:../reversi8_2026.c **** /////////////////////////////////////////////////////////////////////////////////
 285:../reversi8_2026.c **** // Recorre todo el tablero comprobando en cada posición si se puede mover
 286:../reversi8_2026.c **** // En caso afirmativo, consulta la puntuación de la posición y si es la mejor
 287:../reversi8_2026.c **** // que se ha encontrado la guarda
 288:../reversi8_2026.c **** // Al acabar escribe el movimiento seleccionado en f y c
 289:../reversi8_2026.c **** 
 290:../reversi8_2026.c **** // Candidatas
 291:../reversi8_2026.c **** // NO    0
 292:../reversi8_2026.c **** // SI    1
 293:../reversi8_2026.c **** // CASILLA_OCUPADA 2
 294:../reversi8_2026.c **** 
 295:../reversi8_2026.c **** static int elegir_mov(char candidatas[][DIM], char tablero[][DIM], char *f, char *c)
 296:../reversi8_2026.c **** {
 297:../reversi8_2026.c ****     int i, j, k, found;
 298:../reversi8_2026.c ****     int mf = -1; // almacena la fila del mejor movimiento encontrado
 299:../reversi8_2026.c ****     int mc;      // almacena la columna del mejor movimiento encontrado
 300:../reversi8_2026.c ****     char mejor = 0; // almacena el mejor valor encontrado
 301:../reversi8_2026.c ****     int modelo, longitud;
 302:../reversi8_2026.c ****     char SF, SC; // cantidades a sumar para movernos en la dirección que toque
 303:../reversi8_2026.c **** 
 304:../reversi8_2026.c ****     // Recorremos todo el tablero comprobando dónde podemos mover
 305:../reversi8_2026.c ****     // Comparamos la puntuación de los movimientos encontrados y nos quedamos con el mejor
 306:../reversi8_2026.c ****     for (i=0; i<DIM; i++)
 307:../reversi8_2026.c ****     {
 308:../reversi8_2026.c ****         for (j=0; j<DIM; j++)
 309:../reversi8_2026.c ****         {   // indica en qué casillas quizá se pueda mover
 310:../reversi8_2026.c ****             if (candidatas[i][j] == SI)
 311:../reversi8_2026.c ****             {
 312:../reversi8_2026.c ****                 if (tablero[i][j] == CASILLA_VACIA)
 313:../reversi8_2026.c ****                 {
 314:../reversi8_2026.c ****                     found = 0;
 315:../reversi8_2026.c ****                     k = 0;
 316:../reversi8_2026.c **** 
 317:../reversi8_2026.c ****                     // en este bucle comprobamos si es un movimiento válido
 318:../reversi8_2026.c ****                     // (es decir si implica voltear en alguna dirección)
 319:../reversi8_2026.c ****                     while ((found == 0) && (k < DIM))
 320:../reversi8_2026.c ****                     {
 321:../reversi8_2026.c ****                         SF = vSF[k];    // k representa la dirección que miramos
 322:../reversi8_2026.c ****                         SC = vSC[k];    // 1 es norte, 2 NE, 3 E ...
 323:../reversi8_2026.c **** 
 324:../reversi8_2026.c ****                         // nos dice qué hay que voltear en cada dirección
 325:../reversi8_2026.c ****                         longitud = 0;
 326:../reversi8_2026.c ****                         modelo = PATRON_VOLTEO(tablero, &longitud, i, j, SF, SC, FICHA_BLANCA);
 327:../reversi8_2026.c ****                         //  //printf("%d ", modelo);
 328:../reversi8_2026.c ****                         if (modelo == MODELO_ENCONTRADO)
 329:../reversi8_2026.c ****                         {
 330:../reversi8_2026.c ****                             found = 1;
 331:../reversi8_2026.c ****                             if (tabla_valor[i][j] > mejor)
 332:../reversi8_2026.c ****                             {
 333:../reversi8_2026.c ****                                 mf = i;
 334:../reversi8_2026.c ****                                 mc = j;
 335:../reversi8_2026.c ****                                 mejor = tabla_valor[i][j];
 336:../reversi8_2026.c ****                             }
 337:../reversi8_2026.c ****                         }
 338:../reversi8_2026.c ****                         k++;
 339:../reversi8_2026.c ****                         // si no hemos encontrado nada probamos con la siguiente dirección
 340:../reversi8_2026.c ****                     }
 341:../reversi8_2026.c ****                 }
 342:../reversi8_2026.c ****             }
 343:../reversi8_2026.c ****         }
 344:../reversi8_2026.c ****     }
 345:../reversi8_2026.c ****     *f = (char) mf;
 346:../reversi8_2026.c ****     *c = (char) mc;
 347:../reversi8_2026.c ****     // si no se ha encontrado una posición válida devuelve -1
 348:../reversi8_2026.c ****     return mf;
 349:../reversi8_2026.c **** }
 350:../reversi8_2026.c **** 
 351:../reversi8_2026.c **** ////////////////////////////////////////////////////////////////////////////////
 352:../reversi8_2026.c **** // Cuenta el número de fichas de cada color.
 353:../reversi8_2026.c **** // Los guarda en la dirección b (blancas) y n (negras)
 354:../reversi8_2026.c **** 
 355:../reversi8_2026.c **** static void contar(char tablero[][DIM], int *b, int *n)
 356:../reversi8_2026.c **** {
 357:../reversi8_2026.c ****     int i,j;
 358:../reversi8_2026.c **** 
 359:../reversi8_2026.c ****     *b = 0;
 360:../reversi8_2026.c ****     *n = 0;
 361:../reversi8_2026.c **** 
 362:../reversi8_2026.c ****     // recorremos todo el tablero contando las fichas de cada color
 363:../reversi8_2026.c ****     for (i=0; i<DIM; i++)
 364:../reversi8_2026.c ****     {
 365:../reversi8_2026.c ****         for (j=0; j<DIM; j++)
 366:../reversi8_2026.c ****         {
 367:../reversi8_2026.c ****             if (tablero[i][j] == FICHA_BLANCA)
 368:../reversi8_2026.c ****             {
 369:../reversi8_2026.c ****                 (*b)++;
 370:../reversi8_2026.c ****             }
 371:../reversi8_2026.c ****             else if (tablero[i][j] == FICHA_NEGRA)
 372:../reversi8_2026.c ****             {
 373:../reversi8_2026.c ****                 (*n)++;
 374:../reversi8_2026.c ****             }
 375:../reversi8_2026.c ****         }
 376:../reversi8_2026.c ****     }
 377:../reversi8_2026.c **** }
