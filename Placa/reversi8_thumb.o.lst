   1              	# 1 "../reversi8_thumb.asm"
   1              	/*********************************************************************************************
   0              	
   0              	
   0              	
   2              	* Fichero:		reversi8_thumb.asm
   3              	* Autor:		Sergio Benedi 873042, Pablo Gimeno 960280
   4              	* Descrip:		version en ensamblador Thumb de color_ficha() (misma estructura que el C
   5              	*				de reversi8_2026.c y que color_ficha_arm, cumpliendo ATPCS)
   6              	* Version:	1.0
   7              	*********************************************************************************************/
   8              	
   9              	.text
  10              	.thumb
  11              	
  12              	/* Mismos valores que en reversi8_2026.c */
  13              	.equ DIM,				8
  14              	.equ CASILLA_VACIA,		0
  15              	
  16              	/*******************************************************************************************
  17              	* Codigo C original:
  18              	*
  19              	* char color_ficha(char tablero[][DIM], char f, char c, int *es_posicion_correcta)
  20              	* {
  21              	*     char ficha;
  22              	*
  23              	*     if ((f < DIM) && (f >= 0) && (c < DIM) && (c >= 0) && (tablero[f][c] != CASILLA_VACIA))
  24              	*     {
  25              	*         *es_posicion_correcta = 1;
  26              	*         ficha = tablero[f][c];
  27              	*     }
  28              	*     else
  29              	*     {
  30              	*         *es_posicion_correcta = 0;
  31              	*         ficha = CASILLA_VACIA;
  32              	*     }
  33              	*     return ficha;
  34              	* }
  35              	*
  36              	* Entrada:	r0 = tablero
  37              	* 			r1 = f
  38              	* 			r2 = c
  39              	* 			r3 = es_posicion_correcta (puntero)
  40              	* Salida:	r0 = ficha
  41              	* Variables locales: ficha -> r0 (no necesita pila)
  42              	*
  43              	* Marco de pila: ninguno. Es una funcion hoja que solo usa r0-r3 (caller-saved) y no llama
  44              	* a nadie, asi que lr no se pisa y no hay nada que guardar (el guion permite reducir el
  45              	* marco en Thumb). Se retorna con "bx lr": como el llamador es ARM (bit 0 de lr = 0),
  46              	* bx vuelve a estado ARM. "pop {pc}" NO serviria: en ARMv4T no cambia de estado.
  47              	*
  48              	* Llamada desde ARM/C: basta un "bl color_ficha_thumb". Al ser .thumb_func, el enlazador
  49              	* inserta un veneer ARM->Thumb (carga la direccion con bit 0 = 1 y hace bx) porque ARMv4T
  50              	* no tiene blx. Se ve en el .map / desensamblado junto al simbolo color_ficha_thumb.
  51              	*
  52              	* Char sin signo (ver reversi8_arm.asm): una sola comparacion sin signo cubre
  53              	* f < DIM y f >= 0.
  54              	*******************************************************************************************/
  55              	.global color_ficha_thumb
  57              	.thumb_func
  58              	color_ficha_thumb:
  59 0000 0829     			cmp		r1, #DIM				/* sin signo: cubre f < DIM y f >= 0 */
  60 0002 09D2     			bhs		cft_else
  61 0004 082A     			cmp		r2, #DIM				/* sin signo: cubre c < DIM y c >= 0 */
  62 0006 07D2     			bhs		cft_else
  63 0008 C900     			lsl		r1, r1, #3				/* Thumb no tiene desplazamiento integrado en add */
  64 000a 4018     			add		r0, r0, r1				/* r0 = &tablero[f][0] */
  65 000c 805C     			ldrb	r0, [r0, r2]			/* ficha = tablero[f][c] */
  66 000e 0028     			cmp		r0, #CASILLA_VACIA
  67 0010 02D0     			beq		cft_else
  68              	
  69 0012 0121     			mov		r1, #1
  70 0014 1960     			str		r1, [r3]				/* *es_posicion_correcta = 1 */
  71 0016 7047     			bx		lr
  72              	
  73              	cft_else:
  74 0018 0020     			mov		r0, #CASILLA_VACIA		/* ficha = CASILLA_VACIA (= 0) */
  75 001a 1860     			str		r0, [r3]				/* *es_posicion_correcta = 0 (reutiliza el 0 de r0) */
  76 001c 7047     			bx		lr
  77              	
  78              	.end
DEFINED SYMBOLS
../reversi8_thumb.asm:13     *ABS*:00000008 DIM
../reversi8_thumb.asm:14     *ABS*:00000000 CASILLA_VACIA
../reversi8_thumb.asm:58     .text:00000000 color_ficha_thumb
../reversi8_thumb.asm:59     .text:00000000 $t
../reversi8_thumb.asm:73     .text:00000018 cft_else
                   .debug_aranges:0000000c $d

