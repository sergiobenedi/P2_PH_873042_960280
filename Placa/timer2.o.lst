  20:../timer2.c   **** #define T2_MANUAL_UPD	(1 << 13)
  21:../timer2.c   **** #define T2_INVERTER		(1 << 14)
  22:../timer2.c   **** #define T2_AUTO_RELOAD	(1 << 15)
  23:../timer2.c   **** #define T2_BITS			(T2_START | T2_MANUAL_UPD | T2_INVERTER | T2_AUTO_RELOAD)
  24:../timer2.c   **** 
